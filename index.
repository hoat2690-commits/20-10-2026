<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tri Ân Mẹ Và Cô - 20/10/2026 💖</title>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: radial-gradient(circle at center, #fffbeb 0%, #fef3c7 50%, #fde68a 100%);
      font-family: 'Quicksand', sans-serif;
      overflow-x: hidden;
      perspective: 1500px;
      padding: 20px;
    }

    /* Hiệu ứng hạt tim & hoa rơi ngẫu nhiên */
    .particle {
      position: absolute;
      pointer-events: none;
      animation: floatUp 6s linear infinite;
      z-index: 1;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(100vh) rotate(0deg) scale(0.6);
        opacity: 0.8;
      }
      100% {
        transform: translateY(-15vh) rotate(360deg) scale(1.2);
        opacity: 0;
      }
    }

    /* Khung chứa Thiệp 3D gập đôi */
    .card-container {
      position: relative;
      width: 780px;
      max-width: 95vw;
      min-height: 520px;
      z-index: 10;
      display: flex;
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(180, 83, 9, 0.35);
      background: #fdfbf7;
      border: 4px solid #fef3c7;
    }

    /* Trang trái thiệp */
    .card-page-left {
      flex: 1;
      border-right: 2px dashed #fde68a;
      padding: 25px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      text-align: center;
      background: linear-gradient(135deg, #fffdfa 0%, #fff7ed 100%);
      border-top-left-radius: 16px;
      border-bottom-left-radius: 16px;
    }

    /* Trang phải thiệp */
    .card-page-right {
      flex: 1;
      padding: 25px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      text-align: center;
      background: linear-gradient(135deg, #fff7ed 0%, #fffdfa 100%);
      border-top-right-radius: 16px;
      border-bottom-right-radius: 16px;
    }

    .img-frame {
      width: 100%;
      height: 200px;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 8px 20px rgba(217, 119, 6, 0.2);
      border: 3px solid #fff;
      margin-bottom: 12px;
      transition: transform 0.4s ease;
    }

    .img-frame:hover {
      transform: scale(1.03);
    }

    .img-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-title {
      font-family: 'Dancing Script', cursive;
      font-size: 26px;
      color: #b45309;
      margin-bottom: 8px;
    }

    .card-wishes {
      font-family: 'Dancing Script', cursive;
      font-size: 19px;
      color: #78350f;
      line-height: 1.6;
      text-align: justify;
      background: #fefce8;
      padding: 12px 16px;
      border-radius: 12px;
      border: 1px solid #fef08a;
    }

    .sub-text {
      font-size: 13.5px;
      color: #92400e;
      line-height: 1.5;
      margin-top: 6px;
    }

    .author-tag {
      font-family: 'Dancing Script', cursive;
      font-size: 22px;
      font-weight: bold;
      color: #d97706;
      text-align: right;
      width: 100%;
      padding-right: 10px;
    }

    .btn-celebrate {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: white;
      border: none;
      padding: 12px 28px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(217, 119, 6, 0.4);
      transition: all 0.3s ease;
      margin-top: 10px;
    }

    .btn-celebrate:hover {
      transform: translateY(-2px) scale(1.05);
      box-shadow: 0 8px 25px rgba(217, 119, 6, 0.5);
    }

    @media (max-width: 720px) {
      .card-container {
        flex-direction: column;
        height: auto;
      }
      .card-page-left {
        border-right: none;
        border-bottom: 2px dashed #fde68a;
      }
      .card-wishes {
        font-size: 17px;
      }
    }
  </style>
</head>
<body>

  <!-- Hạt hoa & tim bay background -->
  <div id="particles"></div>

  <!-- Thiệp 3D Tri Ân -->
  <div class="card-container">
    <!-- Trang Trái: Mẹ và Con -->
    <div class="card-page-left">
      <div class="img-frame">
        <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=600&q=80" alt="Mẹ yêu thương">
      </div>
      <div class="card-title">Mẹ Cho Con Tình Yêu Bao La 🌻</div>
      <div class="sub-text">
        "Cảm ơn Mẹ đã luôn là điểm tựa bình yên, trao cho con vòng tay ấm áp và tình yêu thương vô điều kiện suốt hành trình trưởng thành."
      </div>
      <p style="font-size: 12px; color: #b45309; font-weight: bold; margin-top: 8px;">20 / 10 / 2026</p>
    </div>

    <!-- Trang Phải: Cô Giáo & Lời Chúc Chi Tiết -->
    <div class="card-page-right">
      <div class="img-frame">
        <img src="https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=600&q=80" alt="Cô giáo kính yêu">
      </div>

      <div class="card-wishes">
        "Kính gửi Mẹ và Cô giáo kính yêu!<br>
        Nhân ngày Phụ nữ Việt Nam 20/10, con xin gửi tới hai người phụ nữ tuyệt vời nhất cuộc đời con lời tri ân sâu sắc nhất. Mẹ trao cho con tình yêu thương bao la, Cô chắp cánh tri thức dìu dắt con nên người. Kính chúc Mẹ và Cô luôn dồi dào sức khỏe, luôn tươi trẻ, hạnh phúc và ngập tràn niềm vui!"
      </div>

      <div class="author-tag">
        Sản phẩm: Phạm Quang Vinh
      </div>

      <button class="btn-celebrate" onclick="burstConfetti()">Gửi Lời Tri Ân Lấp Lánh ✨</button>
    </div>
  </div>

  <script>
    // Hiệu ứng pháo hoa pháo tim lấp lánh khi bấm nút
    function burstConfetti() {
      confetti({
        particleCount: 120,
        spread: 80,
        origin: { y: 0.6 },
        colors: ['#f59e0b', '#d97706', '#f43f5e', '#fb7185', '#fef3c7']
      });

      alert("✨ Phạm Quang Vinh xin gửi lời chúc tốt đẹp nhất đến Mẹ và Cô giáo nhân ngày 20/10!");
    }

    // Tạo hạt hoa hướng dương, hoa hồng & tim bay ngẫu nhiên
    function createParticle() {
      const p = document.createElement('div');
      p.classList.add('particle');
      p.innerHTML = ['🌻', '🌹', '💖', '✨', '💐', '🌸'][Math.floor(Math.random() * 6)];
      p.style.left = Math.random() * 100 + 'vw';
      p.style.fontSize = Math.random() * 16 + 14 + 'px';
      p.style.animationDuration = Math.random() * 3 + 4 + 's';

      document.getElementById('particles').appendChild(p);

      setTimeout(() => p.remove(), 6000);
    }

    setInterval(createParticle, 300);
  </script>
</body>
</html>
